{
  "name": "testdog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build:worker && pnpm test:ui",
    "test:ui": "pnpm build:web && playwright test",
    "dev": "pnpm --filter @testdog/web dev",
    "build": "pnpm build:web && pnpm build:worker",
    "start": "pnpm --filter @testdog/web start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "assign:legacy": "tsx apps/worker/src/assign-legacy-data.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @testdog/web typecheck && tsc --noEmit && pnpm -r --filter \"./packages/**\" --filter @testdog/worker typecheck",
    "worker": "tsx apps/worker/src/worker.ts",
    "maintenance": "tsx apps/worker/src/maintenance.ts",
    "register:build": "tsx apps/worker/src/register-build.ts",
    "recover:resource": "tsx apps/worker/src/recover-resource.ts",
    "notifications": "tsx apps/worker/src/notifications.ts",
    "issues:backfill": "node --import tsx apps/worker/src/backfill-issues.ts",
    "build:web": "pnpm --filter @testdog/web build",
    "build:worker": "pnpm --filter @testdog/worker build",
    "worker:start": "pnpm --filter @testdog/worker start",
    "package:web": "pnpm build:web && node tools/package-deployment.mjs web",
    "package:worker": "pnpm build:worker && node tools/package-deployment.mjs worker"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "tsx": "4.20.6",
    "typescript": "~6.0.2",
    "vitest": "^5.0.2",
    "@aws-sdk/client-s3": "3.1148.0",
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@iconify-icons/lucide": "^2.0.18",
    "@iconify/react": "^6.0.2",
    "@playwright/test": "1.63.0",
    "@xyflow/react": "^12.12.0",
    "acorn": "^8.19.0",
    "agent-device": "0.21.24",
    "better-auth": "^1.7.7",
    "dockview-react": "^8.4.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "ky": "^2.2.0",
    "next": "16.3.4",
    "nodemailer": "^10.1.0",
    "openai": "^7.10.0",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "^6.3.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.4.3",
    "@testdog/contracts": "workspace:*",
    "@testdog/automation": "workspace:*",
    "@testdog/server": "workspace:*"
  }
}
