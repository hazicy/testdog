{
  "name": "caseforge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:ui",
    "test:ui": "pnpm build && playwright test",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "worker": "tsx scripts/worker.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "register:build": "tsx scripts/register-build.ts",
    "recover:resource": "tsx scripts/recover-resource.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@base-ui/react": "^1.8.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@iconify-icons/lucide": "^2.0.18",
    "@iconify/react": "^6.0.2",
    "@playwright/test": "1.63.0",
    "@xyflow/react": "^12.12.0",
    "acorn": "^8.19.0",
    "agent-device": "0.21.24",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "elkjs": "^0.12.0",
    "ky": "^2.2.0",
    "next": "16.3.4",
    "openai": "^7.10.0",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "^6.3.0",
    "swr": "^2.5.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "tsx": "4.20.6",
    "typescript": "~6.0.2",
    "vitest": "^5.0.2"
  }
}
