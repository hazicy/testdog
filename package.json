{
  "name": "testdog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build:worker && pnpm test:ui",
    "test:ui": "pnpm build:web && playwright test",
    "dev": "pnpm --filter @testdog/web dev",
    "build": "pnpm build:web && pnpm build:worker",
    "start": "pnpm --filter @testdog/web start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "assign:legacy": "tsx apps/worker/src/assign-legacy-data.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --no-sort typecheck && pnpm typecheck:repo",
    "worker": "tsx apps/worker/src/worker.ts",
    "maintenance": "tsx apps/worker/src/maintenance.ts",
    "register:build": "tsx apps/worker/src/register-build.ts",
    "recover:resource": "tsx apps/worker/src/recover-resource.ts",
    "notifications": "tsx apps/worker/src/notifications.ts",
    "issues:backfill": "node --import tsx apps/worker/src/backfill-issues.ts",
    "build:web": "pnpm --filter @testdog/web build",
    "build:worker": "pnpm --filter @testdog/worker build",
    "worker:start": "pnpm --filter @testdog/worker start",
    "package:web": "pnpm build:web && node tools/package-deployment.mjs web",
    "package:worker": "pnpm build:worker && node tools/package-deployment.mjs worker",
    "typecheck:repo": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@stylistic/eslint-plugin": "catalog:",
    "@testdog/contracts": "workspace:*",
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
