DATABASE_URL=postgresql://postgres:postgres@localhost:5432/caseforge
# Redis is shared by all API instances and workers; omission enables polling fallback.
REDIS_URL=redis://localhost:6380
# Use distinct prefixes for deployments sharing Redis (Pub/Sub ignores database number).
# CASEFORGE_REDIS_PREFIX=caseforge
# CASEFORGE_PREVIEW_INTERVAL_MS=3000
# DeepSeek API key; the adapter currently reads OPENAI_API_KEY.
OPENAI_API_KEY=
AUTOMATION_HEADLESS=false

# Persistent artifact directory (screenshots, video and trace; defaults to .automation)
# CASEFORGE_DATA_DIR=/path/to/data

# Worker identity and explicitly leased resources. Default: hostname + one Web slot.
# CASEFORGE_HOST_ID=worker-host
# CASEFORGE_RESOURCES=[{"id":"worker-host:web:1","platform":"web","profileId":"mobile"}]
# Native resources additionally require deviceId (ADB serial or iOS UDID).
# ANDROID_SDK_ROOT=/path/to/android-sdk

# Shared private evidence storage. Omit bucket for single-host local disk.
# CASEFORGE_ARTIFACT_BUCKET=private-caseforge-evidence
# CASEFORGE_ARTIFACT_PREFIX=caseforge
# CASEFORGE_ARTIFACT_ENDPOINT=https://s3.example.com
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# Require authentication for remotely exposed workspace (use HTTPS).
# CASEFORGE_REQUIRE_AUTH=true
# CASEFORGE_AUTH_USER=operator
# CASEFORGE_AUTH_PASSWORD=...

# Optional worker concurrency (defaults to registered resource count)
# CASEFORGE_WORKER_CONCURRENCY=1
# CASEFORGE_QUEUE_TIMEOUT_MS=3600000
# Worker-only secrets referenced by target.inputs
# CASEFORGE_SECRET_LOGIN_PASSWORD=...
# Explicit opt-out for controlled local production deployments only
# CASEFORGE_ALLOW_UNAUTHENTICATED=true

# Shared AI budget per test (planning, actions and assertions; retries count as calls)
# CASEFORGE_AI_TIMEOUT_MS=60000
# CASEFORGE_AI_MAX_CALLS=60
# CASEFORGE_AI_MAX_TOKENS=200000
# CASEFORGE_AI_MAX_DURATION_MS=300000
# CASEFORGE_AI_MAX_OUTPUT_TOKENS=8192
# CASEFORGE_AI_MAX_RETRIES=1
