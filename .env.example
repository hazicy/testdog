DATABASE_URL=postgresql://postgres:postgres@localhost:5432/testdog
# Redis is shared by all API instances and workers; omission enables polling fallback.
REDIS_URL=redis://localhost:6380
# Use distinct prefixes for deployments sharing Redis (Pub/Sub ignores database number).
# TESTDOG_REDIS_PREFIX=testdog
# TESTDOG_PREVIEW_INTERVAL_MS=3000
# DeepSeek API key; the adapter currently reads OPENAI_API_KEY.
OPENAI_API_KEY=
AUTOMATION_HEADLESS=true

# Persistent artifact directory (screenshots, video and trace; local workspace defaults to root .automation; use an absolute path in deployment)
# TESTDOG_DATA_DIR=/path/to/data

# Worker identity and explicitly leased resources. Default: hostname + one Web slot.
# TESTDOG_HOST_ID=worker-host
# TESTDOG_RESOURCES=[{"id":"worker-host:web:1","platform":"web","profileId":"mobile"}]
# Native resources additionally require deviceId (ADB serial or iOS UDID).
# ANDROID_SDK_ROOT=/path/to/android-sdk

# Shared private evidence storage. Omit bucket for single-host local disk.
# TESTDOG_ARTIFACT_BUCKET=private-testdog-evidence
# TESTDOG_ARTIFACT_PREFIX=testdog
# TESTDOG_ARTIFACT_ENDPOINT=https://s3.example.com
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# Better Auth: generate a secret with openssl rand -base64 32; use HTTPS in production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional third-party login. Buttons appear only when both values are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional worker concurrency (defaults to registered resource count)
# TESTDOG_WORKER_CONCURRENCY=1
# Default worker and maintenance include maintenance,notifications,outbox.
# Use none on execution workers when a dedicated maintenance process runs these services.
# TESTDOG_BACKGROUND_SERVICES=none
# TESTDOG_QUEUE_TIMEOUT_MS=3600000
# Explicit opt-out for controlled local production deployments only
# TESTDOG_ALLOW_UNAUTHENTICATED=true

# Shared AI budget per test (planning, actions and assertions; retries count as calls)
# TESTDOG_AI_TIMEOUT_MS=60000
# TESTDOG_AI_MAX_CALLS=60
# TESTDOG_AI_MAX_TOKENS=200000
# TESTDOG_AI_MAX_DURATION_MS=300000
# TESTDOG_AI_MAX_OUTPUT_TOKENS=8192
# TESTDOG_AI_MAX_RETRIES=1

# Notification credentials are encrypted. API and notification workers need the same key.
# Omit to use BETTER_AUTH_SECRET; changing the key requires re-entering channel credentials.
# TESTDOG_INTEGRATION_SECRET=at-least-32-characters
# Platform email service. Configure these on API and notification worker processes.
# Users only provide recipients and notification preferences.
# TESTDOG_SMTP_HOST=smtp.example.com
# TESTDOG_SMTP_PORT=465
# TESTDOG_SMTP_USERNAME=notifications@example.com
# TESTDOG_SMTP_PASSWORD=
# TESTDOG_SMTP_FROM=notifications@example.com
# Explicit administrator opt-in for a trusted private SMTP host (TLS remains required).
# TESTDOG_ALLOW_PRIVATE_SMTP=false

# Structured service logs: trace, debug, info, warn, error, fatal, silent.
# TESTDOG_LOG_LEVEL=info
