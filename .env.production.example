# Set a deployment-specific model API key. Never commit live credentials.
OPENAI_API_KEY=

# Docker Compose overrides this with redis://redis:6379.
# For a separately deployed Redis, set its private URL in your untracked environment.
REDIS_URL=

# Generate a unique secret for each deployment: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional social login; configure both values to enable each provider.
# Callback: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
